ML_CLIENT_ID=your_app_id_here
ML_CLIENT_SECRET=your_client_secret_here
ML_SITE_ID=MLB
ML_REDIRECT_URI=http://localhost:3333/callback

# Seguranca: "true" bloqueia todas as ferramentas de escrita (padrao: false)
ML_READ_ONLY=false

# Perfil de ferramentas expostas: all | leitura | vendas | publicacao (padrao: all)
ML_TOOL_PROFILE=all
